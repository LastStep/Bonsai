# Force LF on anything that ends up in a generated shell hook or gets shelled out.
*.sh         text eol=lf
*.sh.tmpl    text eol=lf

# Keep lockfiles + generated-preview goldens predictable across checkouts.
go.sum       text eol=lf
*.yaml       text eol=lf

# The formats set (formats/): every file keeps its committed bytes on every checkout, Windows' core.autocrlf
# included. The CRLF and BOM trick files are the point. This line must stay after `*.yaml text eol=lf`: the last
# matching line wins.
formats/** -text

# The reference page of lists (docs/reference/lists.md) is generated, and its test compares it byte for byte with what the
# code builds: LF on every checkout, Windows' core.autocrlf included.
docs/reference/lists.md text eol=lf

# Every pack file in this repository (packs/: base, the template) is LF on every checkout, Windows' core.autocrlf
# included: the engine writes a pack's files into projects as committed, and base's generated skills are compared byte
# for byte with what the code builds.
packs/** text eol=lf

# The installers (install/): install.sh is LF through *.sh above; install.ps1 is LF too, on every checkout, Windows'
# core.autocrlf included, since install/install_test.go holds both scripts to ASCII with LF line ends.
install/install.ps1 text eol=lf
